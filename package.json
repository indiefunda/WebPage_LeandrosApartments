{
  "name": "leandros-apartments",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Leandros Apartments — beachfront apartments in Platys Gialos, Sifnos. Trilingual (EN/EL/FR) Astro website.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images": "node scripts/prepare-images.mjs",
    "icons": "node scripts/build-icons.mjs",
    "og": "node scripts/build-og.mjs",
    "qa": "node scripts/qa.mjs",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:all": "npm run build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "playwright": "^1.64.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  }
}

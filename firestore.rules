rules_version = '2';

// Leandros Apartments — enquiry inbox
//
// Visitors may only *create* an enquiry. Nobody can read, update or delete
// through the public web API; the family reads enquiries in the Firebase
// console (or with the Admin SDK). This keeps personal data out of reach even
// though the web API key is public.
service cloud.firestore {
  match /databases/{database}/documents {

    match /enquiries/{enquiryId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'arrival', 'departure', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.arrival is string &&
        request.resource.data.departure is string &&
        request.resource.data.createdAt is string &&
        (!('message' in request.resource.data) || request.resource.data.message.size() <= 4000) &&
        (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 60);

      allow read, update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

---
export interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  meta?: string;
}

const { eyebrow, title, intro, meta } = Astro.props;
---

<header class="page-hero shell">
  <div class="page-hero__grid">
    <div class="page-hero__main">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="page-hero__title">{title}</h1>
    </div>
    {
      (intro || meta) && (
        <div class="page-hero__aside">
          {intro && <p class="page-hero__intro">{intro}</p>}
          {meta && <p class="page-hero__meta">{meta}</p>}
        </div>
      )
    }
  </div>
</header>

<style>
  .page-hero {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.25rem, 4.5vw, 4rem);
  }

  .page-hero__grid {
    display: grid;
    gap: 1.75rem;
    align-items: end;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: clamp(1.75rem, 3vw, 2.75rem);
  }

  .page-hero__main {
    display: grid;
    gap: 1rem;
  }

  .page-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 6vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.026em;
    max-width: 15ch;
  }

  .page-hero__aside {
    display: grid;
    gap: 0.9rem;
    max-width: 34rem;
  }

  .page-hero__intro {
    font-size: clamp(1rem, 1.15vw, 1.12rem);
    line-height: 1.7;
    color: var(--color-ink-soft);
  }

  .page-hero__meta {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  @media (min-width: 900px) {
    .page-hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
    }

    .page-hero__aside {
      justify-self: end;
    }
  }

  html[lang='el'] .page-hero__title {
    letter-spacing: 0;
    line-height: 1.04;
  }
</style>

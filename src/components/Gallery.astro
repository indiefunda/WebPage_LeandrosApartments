---
import { getImage, Image } from 'astro:assets';
import Icon from './Icon.astro';
import { photos, type PhotoKey } from '../data/photos';
import type { Locale, SiteContent } from '../content/types';

export interface Props {
  keys: PhotoKey[];
  locale: Locale;
  content: SiteContent;
  title?: string;
  layout?: 'mosaic' | 'strip';
}

const { keys, locale, content: t, title, layout = 'mosaic' } = Astro.props;

const items = await Promise.all(
  keys.map(async (key, index) => {
    const photo = photos[key];
    const full = await getImage({ src: photo.src, width: 1400, format: 'webp', quality: 80 });
    return {
      key,
      src: full.src,
      width: full.attributes.width,
      height: full.attributes.height,
      alt: photo.alt[locale],
      index,
    };
  }),
);

const galleryLabel = title ?? t.actions.gallery;
const data = items.map(({ src, width, height, alt }) => ({ src, width, height, alt }));
---

<section class:list={['gallery', `gallery--${layout}`]} data-gallery aria-label={galleryLabel}>
  <ul class="gallery__grid">
    {
      items.map((item) => (
        <li class:list={['gallery__item', item.index === 0 && 'gallery__item--lead']}>
          <button
            class="gallery__button"
            type="button"
            data-lb-open
            data-index={item.index}
            aria-label={`${t.actions.viewGallery} — ${item.alt}`}
          >
            <Image
              src={photos[item.key].src}
              alt={item.alt}
              widths={[360, 540, 760, 1000]}
              sizes="(min-width: 760px) 24vw, 50vw"
              loading="lazy"
              decoding="async"
              quality={68}
              class="gallery__img"
            />
            <span class="gallery__zoom" aria-hidden="true">
              <Icon name="plus" />
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" data-lb-dialog aria-label={galleryLabel}>
    <div class="lightbox__inner">
      <button class="lightbox__close" type="button" data-lb-close aria-label={t.actions.close}>
        <Icon name="close" />
      </button>
      <figure class="lightbox__figure">
        <img class="lightbox__img" data-lb-img src={items[0]?.src} alt={items[0]?.alt} />
        <figcaption class="lightbox__caption">
          <span data-lb-caption></span>
          <span class="lightbox__counter" data-lb-counter></span>
        </figcaption>
      </figure>
      <div class="lightbox__nav">
        <button type="button" class="lightbox__arrow" data-lb-prev aria-label={t.actions.previous}>
          <Icon name="chevron-left" />
        </button>
        <button type="button" class="lightbox__arrow" data-lb-next aria-label={t.actions.next}>
          <Icon name="chevron-right" />
        </button>
      </div>
    </div>
  </dialog>

  <script type="application/json" data-lb-data set:html={JSON.stringify(data)} />
</section>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gallery__item {
    min-width: 0;
  }

  .gallery__button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--color-paper-deep);
    cursor: zoom-in;
    overflow: hidden;
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 1s var(--ease-out-expo);
  }

  .gallery__button:hover .gallery__img,
  .gallery__button:focus-visible .gallery__img {
    transform: scale(1.04);
  }

  .gallery__zoom {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: rgb(247 242 233 / 0.9);
    color: var(--color-ink);
    opacity: 0;
    transform: translateY(0.35rem);
    transition:
      opacity 0.4s ease,
      transform 0.4s var(--ease-out-soft);
  }

  .gallery__zoom :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }

  .gallery__button:hover .gallery__zoom,
  .gallery__button:focus-visible .gallery__zoom {
    opacity: 1;
    transform: none;
  }

  /* Mosaic: the first frame leads. */
  @media (min-width: 760px) {
    .gallery--mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .gallery--mosaic .gallery__item--lead {
      grid-column: span 2;
      grid-row: span 2;
    }

    .gallery--mosaic .gallery__item--lead .gallery__img {
      aspect-ratio: 1 / 1;
      height: 100%;
    }

    .gallery--mosaic .gallery__item:not(.gallery__item--lead) .gallery__img {
      aspect-ratio: 4 / 3;
    }
  }

  /* Strip: a horizontal, scroll-snapping rail. */
  .gallery--strip .gallery__grid {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }

  .gallery--strip .gallery__grid::-webkit-scrollbar {
    display: none;
  }

  .gallery--strip .gallery__item {
    flex: 0 0 min(78vw, 26rem);
    scroll-snap-align: start;
  }

  .gallery--strip .gallery__img {
    aspect-ratio: 4 / 5;
  }

  /* Lightbox -------------------------------------------------------------- */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    margin: 0;
    background: transparent;
  }

  .lightbox::backdrop {
    background: rgb(8 26 29 / 0.94);
    backdrop-filter: blur(4px);
  }

  .lightbox__inner {
    display: grid;
    grid-template-rows: 1fr auto;
    width: 100%;
    height: 100%;
    padding: clamp(0.75rem, 3vw, 2.25rem);
  }

  .lightbox__figure {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.9rem;
    margin: 0;
    min-height: 0;
  }

  .lightbox__img {
    width: 100%;
    height: 100%;
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
    animation: lb-in 0.55s var(--ease-out-expo);
  }

  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .lightbox__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8rem;
    color: rgb(247 242 233 / 0.72);
  }

  .lightbox__counter {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
  }

  .lightbox__close {
    position: absolute;
    top: clamp(0.75rem, 3vw, 1.75rem);
    right: clamp(0.75rem, 3vw, 1.75rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid rgb(247 242 233 / 0.28);
    background: transparent;
    color: var(--color-paper);
    cursor: pointer;
  }

  .lightbox__close:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .lightbox__nav {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    padding-top: 0.9rem;
  }

  .lightbox__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 2.9rem;
    border: 1px solid rgb(247 242 233 / 0.28);
    background: transparent;
    color: var(--color-paper);
    cursor: pointer;
  }

  .lightbox__arrow:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .lightbox__arrow :global(svg),
  .lightbox__close :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  @media (max-width: 640px) {
    .lightbox__nav {
      display: none;
    }

    .lightbox__img {
      max-height: calc(100dvh - 7rem);
    }
  }
</style>

<script>
  const galleries = document.querySelectorAll<HTMLElement>('[data-gallery]');

  galleries.forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-lb-dialog]');
    const img = root.querySelector<HTMLImageElement>('[data-lb-img]');
    const caption = root.querySelector<HTMLElement>('[data-lb-caption]');
    const counter = root.querySelector<HTMLElement>('[data-lb-counter]');
    const dataEl = root.querySelector<HTMLScriptElement>('[data-lb-data]');
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-lb-open]'));

    if (!dialog || !img || !dataEl || triggers.length === 0) return;

    const items = JSON.parse(dataEl.textContent || '[]') as {
      src: string;
      alt: string;
      width: number;
      height: number;
    }[];

    let current = 0;
    let lastTrigger: HTMLButtonElement | null = null;
    let touchStartX = 0;

    const render = () => {
      const item = items[current];
      if (!item) return;
      img.src = item.src;
      img.alt = item.alt;
      img.width = item.width;
      img.height = item.height;
      if (caption) caption.textContent = item.alt;
      if (counter) counter.textContent = `${current + 1} / ${items.length}`;
      img.style.animation = 'none';
      // Force a reflow so the fade replays on each change.
      void img.offsetWidth;
      img.style.animation = '';
    };

    const open = (index: number, trigger: HTMLButtonElement) => {
      current = index;
      lastTrigger = trigger;
      render();
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    };

    const close = () => dialog.close();

    const step = (delta: number) => {
      current = (current + delta + items.length) % items.length;
      render();
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => open(Number(trigger.dataset.index ?? 0), trigger));
    });

    root.querySelector('[data-lb-close]')?.addEventListener('click', close);
    root.querySelector('[data-lb-prev]')?.addEventListener('click', () => step(-1));
    root.querySelector('[data-lb-next]')?.addEventListener('click', () => step(1));

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      lastTrigger?.focus();
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      }
    });

    dialog.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = event.changedTouches[0]?.clientX ?? 0;
      },
      { passive: true },
    );

    dialog.addEventListener(
      'touchend',
      (event) => {
        const endX = event.changedTouches[0]?.clientX ?? 0;
        const delta = endX - touchStartX;
        if (Math.abs(delta) > 45) step(delta > 0 ? -1 : 1);
      },
      { passive: true },
    );
  });
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import BookingForm from '../BookingForm.astro';
import MapCard from '../MapCard.astro';
import Icon from '../Icon.astro';
import { getContent } from '../../content';
import type { Locale } from '../../content/types';
import { property } from '../../data/property';
import { breadcrumbs } from '../../data/schema';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);

const crumbs = breadcrumbs(
  [
    { name: t.nav.home, path: '' },
    { name: t.nav.contact, path: 'contact/' },
  ],
  locale,
);
---

<BaseLayout locale={locale} path="contact/" meta={t.meta.contact} ogImage="/og/contact.jpg" jsonLd={crumbs}>
  <PageHero
    eyebrow={t.contactPage.eyebrow}
    title={t.contactPage.title}
    intro={t.contactPage.intro}
    meta={`${property.phones.landlineDisplay} · ${property.phones.mobile1Display}`}
  />

  <section class="section-tight contact">
    <div class="shell contact__grid">
      <div class="contact__form">
        <h2 class="contact__title">{t.contactPage.formTitle}</h2>
        <BookingForm locale={locale} content={t} />
      </div>

      <aside class="contact__aside">
        <div class="contact-card">
          <h2 class="contact-card__title">{t.contactPage.phoneTitle}</h2>
          <p class="contact-card__note">{t.contactPage.phoneNote}</p>
          <ul class="contact-card__phones">
            <li>
              <a href={`tel:${property.phones.landline}`}>
                <Icon name="phone" class="icon-sm" />
                {property.phones.landlineDisplay}
              </a>
            </li>
            <li>
              <a href={`tel:${property.phones.mobile1}`}>
                <Icon name="phone" class="icon-sm" />
                {property.phones.mobile1Display}
              </a>
            </li>
            <li>
              <a href={`tel:${property.phones.mobile2}`}>
                <Icon name="phone" class="icon-sm" />
                {property.phones.mobile2Display}
              </a>
            </li>
          </ul>

          <a
            class="btn contact-card__wa"
            href={`https://wa.me/${property.whatsapp}`}
            target="_blank"
            rel="noopener"
          >
            <Icon name="whatsapp" class="icon-sm" />
            {t.contactPage.whatsappTitle}
          </a>
          <p class="contact-card__note">{t.contactPage.whatsappBody}</p>

          <div class="contact-card__address">
            <h3 class="contact-card__subtitle">{t.contactPage.addressTitle}</h3>
            <address>
              {t.footer.address.map((line) => <span>{line}</span>)}
            </address>
            <p class="contact-card__mte">
              {t.footer.mteLabel}
              <strong>{t.footer.mte}</strong>
            </p>
          </div>
        </div>

        <div class="contact-directions">
          <h2 class="contact-directions__title">{t.contactPage.directionsTitle}</h2>
          <ul>
            {t.contactPage.directions.map((item) => <li>{item}</li>)}
          </ul>
          <p class="contact-directions__response">{t.contactPage.response}</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section-tight contact-map">
    <div class="shell">
      <MapCard
        content={t}
        title={t.contactPage.mapTitle}
        note={t.contactPage.mapNote}
        cta={t.contactPage.mapCta}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .contact__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .contact__form {
    display: grid;
    gap: 1.5rem;
    padding-top: 0.5rem;
  }

  .contact__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.05;
  }

  .contact__aside {
    display: grid;
    gap: 1.5rem;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }

  .contact-card {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
  }

  .contact-card__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  .contact-card__note {
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  .contact-card__phones {
    display: grid;
    gap: 0.3rem;
    list-style: none;
    margin: 0.3rem 0;
    padding: 0;
  }

  .contact-card__phones a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding-block: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    text-decoration: none;
  }

  .contact-card__phones a:hover {
    color: var(--color-clay);
  }

  .contact-card__wa {
    justify-content: flex-start;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .contact-card__address {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .contact-card__subtitle {
    font-family: var(--font-sans);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .contact-card__address address {
    display: grid;
    font-style: normal;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .contact-card__mte {
    font-size: 0.72rem;
    color: var(--color-ink-muted);
  }

  .contact-card__mte strong {
    font-weight: 500;
    color: var(--color-ink);
  }

  .contact-directions {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 1px solid var(--color-line);
  }

  .contact-directions__title {
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .contact-directions ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .contact-directions li {
    padding-left: 1rem;
    position: relative;
  }

  .contact-directions li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.32rem;
    height: 1px;
    background: var(--color-clay);
  }

  .contact-directions__response {
    margin-top: 0.35rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-line-soft);
    font-size: 0.76rem;
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .contact-map {
    background: var(--color-paper-deep);
    border-block: 1px solid var(--color-line);
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  @media (min-width: 900px) {
    .contact__grid {
      grid-template-columns: 1.35fr 0.65fr;
      gap: 4rem;
    }
  }

  html[lang='el'] .contact-card__subtitle {
    text-transform: none;
    letter-spacing: 0.04em;
  }
</style>

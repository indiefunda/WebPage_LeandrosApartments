---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { getContent } from '../../content';
import type { Locale } from '../../content/types';
import { localeHome, localizePath, locales, localeMeta } from '../../i18n/routing';

export interface Props {
  locale: Locale;
  /** Path of the missing page, if known. */
  attempted?: string;
}

const { locale, attempted } = Astro.props;
const t = getContent(locale);
---

<BaseLayout locale={locale} path="404/" meta={t.meta.notFound} noindex>
  <section class="notfound">
    <div class="shell notfound__inner">
      <p class="notfound__code" aria-hidden="true">404</p>
      <h1 class="notfound__title">{t.notFound.title}</h1>
      <p class="notfound__body">{t.notFound.body}</p>
      {attempted && <p class="notfound__attempted">{attempted}</p>}

      <a class="btn" href={localeHome(locale)}>
        {t.notFound.cta}
        <Icon name="arrow-right" class="btn__arrow" />
      </a>

      <ul class="notfound__langs" aria-label={t.actions.language}>
        {
          locales.map((item) => (
            <li>
              <a
                href={localizePath(item, '')}
                hreflang={localeMeta[item].htmlLang}
                lang={localeMeta[item].htmlLang}
              >
                {localeMeta[item].label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    place-items: center;
    min-height: calc(100dvh - var(--header-h) - 4rem);
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .notfound__inner {
    display: grid;
    justify-items: center;
    gap: 1.15rem;
    text-align: center;
    max-width: 38rem;
  }

  .notfound__code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 8rem);
    line-height: 0.8;
    color: var(--color-clay);
    opacity: 0.85;
    margin-top: 0.5rem;
  }

  .notfound__title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .notfound__body {
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  .notfound__attempted {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
    word-break: break-all;
  }

  .notfound__inner .btn {
    margin-top: 0.75rem;
  }

  .notfound__langs {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--color-line);
    font-size: 0.75rem;
  }

  .notfound__langs a {
    text-decoration: none;
    color: var(--color-ink-muted);
  }

  .notfound__langs a:hover {
    color: var(--color-clay);
  }
</style>

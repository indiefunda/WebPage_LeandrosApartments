---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../Gallery.astro';
import Icon from '../Icon.astro';
import MediaFrame from '../MediaFrame.astro';
import { getContent } from '../../content';
import type { Locale } from '../../content/types';
import { localizePath } from '../../i18n/routing';
import { photos, unitGalleries, type PhotoKey } from '../../data/photos';
import { apartmentSchema, breadcrumbs } from '../../data/schema';

export interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const t = getContent(locale);
const unit = t.units.find((item) => item.slug === slug);

if (!unit) {
  throw new Error(`Unknown apartment slug: ${slug}`);
}

const index = t.units.findIndex((item) => item.slug === slug);
const covers: PhotoKey[] = ['m1-balcony', 'f2-veranda', 'b3-balcony'];
const cover = photos[covers[index] ?? 'house-front'];
const galleryKeys = (unitGalleries[slug] ?? []).slice(1);
const others = t.units.filter((item) => item.slug !== slug);
const contactHref = localizePath(locale, 'contact/');
const path = `apartments/${slug}/`;

const crumbs = breadcrumbs(
  [
    { name: t.nav.home, path: '' },
    { name: t.nav.apartments, path: 'apartments/' },
    { name: unit.name, path },
  ],
  locale,
);
---

<BaseLayout
  locale={locale}
  path={path}
  meta={{
    title: `${unit.name} — Leandros Apartments, Platys Gialos, Sifnos`,
    description: unit.intro,
  }}
  ogImage={`/og/${slug}.jpg`}
  jsonLd={[crumbs, apartmentSchema(t, locale, slug)]}
>
  <nav class="crumbs shell" aria-label="Breadcrumb">
    <ol>
      <li><a href={localizePath(locale, '')}>{t.nav.home}</a></li>
      <li><a href={localizePath(locale, 'apartments/')}>{t.nav.apartments}</a></li>
      <li aria-current="page">{unit.name}</li>
    </ol>
  </nav>

  <header class="unit-hero shell">
    <div class="unit-hero__copy">
      <p class="eyebrow">{unit.number}</p>
      <h1 class="unit-hero__title">{unit.name}</h1>
      <p class="unit-hero__tagline">{unit.tagline}</p>
      <p class="unit-hero__intro">{unit.intro}</p>

      <dl class="unit-hero__meta">
        <div>
          <dt>{t.common.sleeps}</dt>
          <dd>{unit.sleeps} {t.common.guests}</dd>
        </div>
        <div>
          <dt>{t.common.from}</dt>
          <dd>€{unit.fromPrice} / {t.common.perNight}</dd>
        </div>
      </dl>

      <div class="unit-hero__actions">
        <a class="btn" href={`${contactHref}?apartment=${slug}`}>
          {t.actions.book}
          <Icon name="arrow-right" class="btn__arrow" />
        </a>
        <a class="link-arrow" href={localizePath(locale, 'rates/')}>{t.actions.seeRates}</a>
      </div>
    </div>

    <div class="unit-hero__media">
      <Picture
        src={cover.src}
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 900px) 48vw, 100vw"
        alt={cover.alt[locale]}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        quality={74}
      />
    </div>
  </header>

  <section class="section unit-detail">
    <div class="shell unit-detail__grid">
      <div class="unit-detail__block">
        <h2 class="unit-detail__title">{t.apartmentsPage.specsTitle}</h2>
        <dl class="spec-list">
          {
            unit.layout.map((row) => (
              <div class="spec-list__row">
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="unit-detail__block">
        <h2 class="unit-detail__title">{t.apartmentsPage.bedsTitle}</h2>
        <ul class="plain-list">
          {unit.beds.map((bed) => <li>{bed}</li>)}
        </ul>

        <h2 class="unit-detail__title unit-detail__title--spaced">{t.apartmentsPage.featuresTitle}</h2>
        <ul class="chip-list">
          {
            unit.features.map((feature) => (
              <li class="tag">
                <Icon name="check" class="icon-xs" />
                {feature}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight unit-gallery">
    <div class="shell">
      <div class="unit-gallery__head">
        <h2 class="display-md">{t.apartmentsPage.galleryTitle}</h2>
        <p class="figure-caption">{t.common.photos} · {galleryKeys.length + 1}</p>
      </div>
      <Gallery keys={galleryKeys} locale={locale} content={t} title={unit.name} />
    </div>
  </section>

  <section class="section-tight">
    <div class="shell">
      <div class="unit-cta" data-reveal>
        <div>
          <p class="eyebrow eyebrow--light">{t.home.closing.eyebrow}</p>
          <p class="unit-cta__title">{unit.name}</p>
          <p class="unit-cta__body">{t.contactPage.response}</p>
        </div>
        <div class="unit-cta__actions">
          <a class="btn btn--light" href={`${contactHref}?apartment=${slug}`}>
            {t.actions.book}
            <Icon name="arrow-right" class="btn__arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section unit-others">
    <div class="shell">
      <h2 class="display-md unit-others__title">{t.common.otherApartments}</h2>
      <div class="unit-others__grid">
        {
          others.map((other, i) => {
            return (
              <a
                class="other"
                href={localizePath(locale, `apartments/${other.slug}/`)}
                data-reveal
                style={`--reveal-delay:${i}`}
              >
                <MediaFrame
                  photo={
                    other.slug === 'maisonette'
                      ? 'm1-balcony'
                      : other.slug === 'family-apartment'
                        ? 'f2-veranda'
                        : 'b3-balcony'
                  }
                  locale={locale}
                  ratio="4 / 3"
                  sizes="(min-width: 760px) 45vw, 100vw"
                />
                <span class="other__name">{other.name}</span>
                <span class="other__meta">
                  {t.common.from} €{other.fromPrice} · {t.common.sleeps} {other.sleeps}
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs {
    padding-top: 1.5rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    opacity: 0.5;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--color-clay);
  }

  .crumbs [aria-current] {
    color: var(--color-ink);
  }

  .unit-hero {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .unit-hero__copy {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .unit-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.6vw, 4.6rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
  }

  .unit-hero__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.35;
    color: var(--color-sea);
    max-width: 30ch;
  }

  .unit-hero__intro {
    max-width: 48ch;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }

  .unit-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin: 0.4rem 0;
    padding-block: 1rem;
    border-block: 1px solid var(--color-line);
  }

  .unit-hero__meta dt {
    font-size: 0.63rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .unit-hero__meta dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .unit-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .unit-hero__media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .unit-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .unit-detail {
    background: var(--color-paper-deep);
    border-block: 1px solid var(--color-line);
  }

  .unit-detail__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .unit-detail__block {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .unit-detail__title {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .unit-detail__title--spaced {
    margin-top: 1.5rem;
  }

  .spec-list {
    display: grid;
    margin: 0;
  }

  .spec-list__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding-block: 0.8rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.9rem;
  }

  .spec-list__row:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .spec-list dt {
    color: var(--color-ink-muted);
    font-size: 0.8rem;
    padding-top: 0.1rem;
  }

  .spec-list dd {
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.6;
  }

  .plain-list {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
  }

  .plain-list li {
    padding-left: 1rem;
    position: relative;
  }

  .plain-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.35rem;
    height: 1px;
    background: var(--color-clay);
  }

  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chip-list .tag {
    background: color-mix(in oklab, var(--color-cream) 55%, transparent);
  }

  .unit-gallery__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .unit-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    background: var(--color-sea);
    color: var(--color-paper);
  }

  .unit-cta__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    line-height: 1.05;
    margin-top: 0.6rem;
  }

  .unit-cta__body {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: rgb(247 242 233 / 0.75);
    max-width: 40ch;
  }

  .unit-others__title {
    margin-bottom: 1.75rem;
  }

  .unit-others__grid {
    display: grid;
    gap: 1.5rem;
  }

  .other {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
  }

  .other__name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.15;
  }

  .other:hover .other__name {
    color: var(--color-clay);
  }

  .other__meta {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  @media (min-width: 760px) {
    .unit-others__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .unit-hero {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 5vw, 4.5rem);
    }

    .unit-detail__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  html[lang='el'] .crumbs ol,
  html[lang='el'] .unit-hero__meta dt,
  html[lang='el'] .unit-detail__title,
  html[lang='el'] .other__meta {
    text-transform: none;
    letter-spacing: 0.04em;
  }
</style>

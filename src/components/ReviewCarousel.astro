---
import Icon from './Icon.astro';
import type { Review, SiteContent } from '../content/types';

export interface Props {
  reviews: Review[];
  content: SiteContent;
  note: string;
  title: string;
}

const { reviews, content: t, note, title } = Astro.props;
---

<div class="reviews" data-reviews>
  <div class="reviews__rail no-scrollbar" data-reviews-rail aria-label={title} tabindex="0">
    {
      reviews.map((review, index) => (
        <article class="review" data-reveal style={`--reveal-delay:${index % 3}`}>
          <span class="review__mark" aria-hidden="true">
            “
          </span>
          <blockquote class="review__quote">{review.quote}</blockquote>
          <footer class="review__foot">
            <p class="review__author">
              {review.author}
              <span class="review__origin">{review.origin}</span>
            </p>
            <p class="review__note">{note}</p>
          </footer>
        </article>
      ))
    }
  </div>

  <div class="reviews__controls">
    <div class="reviews__buttons">
      <button type="button" class="reviews__btn" data-reviews-prev aria-label={t.actions.previous}>
        <Icon name="chevron-left" />
      </button>
      <button type="button" class="reviews__btn" data-reviews-next aria-label={t.actions.next}>
        <Icon name="chevron-right" />
      </button>
    </div>
    <p class="reviews__hint" aria-hidden="true">01 — {String(reviews.length).padStart(2, '0')}</p>
  </div>
</div>

<style>
  .reviews__rail {
    display: flex;
    gap: clamp(1.5rem, 3vw, 3rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 1rem;
  }

  .review {
    flex: 0 0 min(88vw, 30rem);
    scroll-snap-align: start;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .review__mark {
    font-family: var(--font-display);
    font-size: 3.2rem;
    line-height: 0.6;
    color: var(--color-clay);
    opacity: 0.55;
  }

  .review__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.55vw, 1.42rem);
    line-height: 1.42;
    letter-spacing: -0.005em;
    color: var(--color-ink);
  }

  .review__foot {
    display: grid;
    gap: 0.35rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-line-soft);
  }

  .review__author {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .review__origin {
    font-weight: 400;
    color: var(--color-ink-muted);
  }

  .review__note {
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    color: var(--color-ink-muted);
  }

  .reviews__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .reviews__buttons {
    display: flex;
    gap: 0.5rem;
  }

  .reviews__btn {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.75rem;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      opacity 0.3s ease;
  }

  .reviews__btn:hover:not(:disabled) {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .reviews__btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .reviews__btn :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .reviews__hint {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((root) => {
    const rail = root.querySelector<HTMLElement>('[data-reviews-rail]');
    const prev = root.querySelector<HTMLButtonElement>('[data-reviews-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-reviews-next]');
    if (!rail || !prev || !next) return;

    const cardWidth = () => {
      const card = rail.querySelector<HTMLElement>('.review');
      if (!card) return rail.clientWidth;
      const gap = parseFloat(getComputedStyle(rail).columnGap || '24') || 24;
      return card.getBoundingClientRect().width + gap;
    };

    const update = () => {
      const max = rail.scrollWidth - rail.clientWidth - 2;
      prev.disabled = rail.scrollLeft <= 2;
      next.disabled = rail.scrollLeft >= max;
    };

    prev.addEventListener('click', () => rail.scrollBy({ left: -cardWidth(), behavior: 'smooth' }));
    next.addEventListener('click', () => rail.scrollBy({ left: cardWidth(), behavior: 'smooth' }));
    rail.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

  {name === 'check' && <path d="m4.5 12.5 5 5 10-11" />}
  {
    name === 'plus' && (
      <>
        <>
          <path d="M12 4v16" />
          <path d="M4 12h16" />
        </>
      </>
    )
  }
  {
    name === 'sun' && (
      <>

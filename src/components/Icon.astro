      />
    )
  }
  {
    name === 'mail' && (
      <>
        <>
          <rect x="3" y="5.5" width="18" height="13" rx="1.5" />
          <path d="m3.8 6.6 8.2 6 8.2-6" />
        </>
      </>
    )
  }
  {
    name === 'menu' && (
      <>
        <>
          <path d="M3.5 7h17" />
          <path d="M3.5 12h17" />
          <path d="M3.5 17h17" />

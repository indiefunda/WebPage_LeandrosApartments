---
import type { Review, SiteContent } from '../content/types';

export interface Props {
  reviews: Review[];
  content: SiteContent;
}

const { reviews } = Astro.props;

// A curated six: family stay, cleanliness, two short international quotes and
// the French regular. No horizontal scrolling, no controls, nothing hidden.
const featured = [0, 1, 2, 3, 5, 6]
  .map((index) => reviews[index])
  .filter((review): review is Review => Boolean(review));
---

<div class="reviews">
  <div class="reviews__wall">
    {
      featured.map((review) => (
        <figure class="review">
          <span class="review__mark" aria-hidden="true">
            “
          </span>
          <blockquote class="review__quote">{review.quote}</blockquote>
          <figcaption class="review__foot">
            <span class="review__author">{review.author}</span>
            <span class="review__origin">{review.origin}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<style>
  .reviews__wall {
    columns: 3 18rem;
    column-gap: clamp(1.75rem, 4vw, 3rem);
  }

  .review {
    break-inside: avoid;
    margin: 0 0 clamp(1.75rem, 3vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .review__mark {
    display: block;
    margin-bottom: 0.55rem;
    font-family: var(--font-display);
    font-size: 2.7rem;
    line-height: 0.55;
    color: var(--color-clay);
    opacity: 0.5;
  }

  .review__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.08rem, 1.25vw, 1.22rem);
    line-height: 1.45;
    letter-spacing: -0.002em;
    color: var(--color-ink);
  }

  .review__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.55rem;
    margin-top: 0.9rem;
  }

  .review__author {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .review__origin {
    font-size: 0.76rem;
    color: var(--color-ink-muted);
  }

  @media (max-width: 640px) {
    .reviews__wall {
      columns: 1;
    }

    .review {
      margin-bottom: 1.9rem;
    }
  }
</style>
